<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Alarms are cleared by a reboot; re-arm the breaking-news check afterwards. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Lets the app find a real browser for links it must not handle itself. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>
    <application
        android:name=".FirsthandApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Firsthand"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Firsthand">
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustNothing"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Google share links (Discover / Google app "Share"): resolved in-app; non-BBC ones go straight on to the browser. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="share.google" />
                <data android:host="search.app" />
            </intent-filter>
            <!-- "Share > Firsthand" from any app: opens the BBC link in the shared text. -->
            <intent-filter android:label="Open in Firsthand">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- link-aliases:start (generated from Sources.catalog by ManifestAliasesTest; see CLAUDE.md to regenerate) -->
        <!-- BBC News links (/news) plus Weather and Sport articles. Not auto-verified: the user enables them under Settings > Open by default. -->
        <activity-alias
            android:name=".link.bbc"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:label="Firsthand">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="www.bbc.com" />
                <data android:host="bbc.com" />
                <data android:host="www.bbc.co.uk" />
                <data android:host="bbc.co.uk" />
                <data android:host="m.bbc.co.uk" />
                <data android:path="/news" />
                <data android:pathPrefix="/news/" />
                <data android:pathPrefix="/weather/articles/" />
                <data android:pathPattern="/sport/.*/articles/.*" />
            </intent-filter>
        </activity-alias>
